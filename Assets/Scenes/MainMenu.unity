  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "This interactive AR Garden Dictionary is an immersive spatial computing
    application built in Unity using AR Foundation. Designed to bridge the physical
    and digital worlds, the app leverages advanced plane detection to track real-world
    environments, allowing users to dynamically cultivate a virtual garden with a
    single touch. \n\n\nEach tap on a tracked surface spawns a uniquely configured,
    randomized flower prefab featuring custom metadata and physics colliders. Beyond
    mere placement, the application features an integrated raycasting system that
    allows users to tap on any existing plant to instantly display a sleek, localized
    TextMeshPro UI overlay. This overlay acts as a living botanical encyclopedia,
    instantly presenting the specific name and detailed educational description tied
    to that exact flower."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8d84d5d9f86a8db41ba6281b12ed920b, type: 2}
  m_sharedMaterial: {fileID: -595468313333698359, guid: 8d84d5d9f86a8db41ba6281b12ed920b, type: 2}
